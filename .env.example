# Database (Docker Compose)
USER=jobs_user
PASSWORD=change_this_password
DB=jobs_automation
PORT=5433
DATABASE_URL=postgresql+asyncpg://jobs_user:change_this_password@postgres:5432/jobs_automation

# Personal files: add these PDFs locally; do not commit them.
RESUME_FILE=
COVER_LETTER_FILE=

# Gmail OAuth files (store locally and keep out of Git)
GMAIL_CREDENTIALS_FILE=assets/client_secret.json
GMAIL_TOKEN_FILE=assets/token.json

# Email and Gemini
DAILY_EMAIL_LIMIT=20
GEMINI_API_KEY=replace_with_your_api_key
GEMINI_MODEL=gemini-2.0-flash
SENDER_NAME=Your Name
EMPLOYER_NAME=Hiring Manager
LOCATION=United States
